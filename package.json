{
  "name": "lish",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "type": "module",
  "bin": {
    "lish": "./dist/cli.js"
  },
  "scripts": {
    "test": "tsx scripts/run-tests.ts",
    "test:kernel": "tsx src/kernel/test.ts",
    "test:events": "tsx src/kernel/test-events.ts",
    "test:core": "tsx src/core/test-session-llm.ts",
    "test:agent": "tsx src/core/test-agent.ts",
    "test:fs": "tsx src/tools/test-fs.ts",
    "test:openai": "tsx src/core/providers/test-openai.ts",
    "test:stream": "tsx src/core/test-stream.ts",
    "start:tui": "tsx src/tui.tsx",
    "start:web": "npm run start:dev",
    "start": "tsx src/cli.ts",
    "start:web:api": "tsx src/server.ts",
    "build:web": "cd web && npm run build",
    "build": "npm run build:web && npm run build:cli && npm run build:assets",
    "build:cli": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "start:dev": "concurrently -n api,web -c blue,magenta \"tsx src/server.ts\" \"cd web && npm run dev\"",
    "test:plugins": "tsx src/core/plugins/test-plugins.ts",
    "lint": "eslint src scripts examples",
    "test:trace": "tsx src/core/test-trace.ts",
    "test:subagent": "tsx src/core/test-subagent.ts",
    "build:assets": "node scripts/copy-web-assets.mjs",
    "prepare": "npm run build:web:ci && npm run build:cli && npm run build:assets",
    "build:web:ci": "node scripts/ensure-web-deps.mjs && cd web && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiStudioorg/lish.git"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/LiStudioorg/lish/issues"
  },
  "homepage": "https://github.com/LiStudioorg/lish#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ai": "^4.3.19",
    "commander": "^15.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1",
    "react-devtools-core": "^8.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
